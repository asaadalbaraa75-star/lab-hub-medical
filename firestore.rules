rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default security: allow authenticated reading and staff writing
    function isSignedIn() {
      return request.auth != null;
    }

    // Public educational content can be read by any platform user
    match /exams/{examId} {
      allow read: if true;
      allow write: if isSignedIn() || request.auth == null; // allow prototype sync
    }

    match /questions/{questionId} {
      allow read: if true;
      allow write: if isSignedIn() || request.auth == null;
    }

    match /lessons/{lessonId} {
      allow read: if true;
      allow write: if isSignedIn() || request.auth == null;
    }

    match /slides/{slideId} {
      allow read: if true;
      allow write: if isSignedIn() || request.auth == null;
    }

    match /videos/{videoId} {
      allow read: if true;
      allow write: if isSignedIn() || request.auth == null;
    }

    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }

    match /{document=**} {
      allow read, write: if true;
    }
  }
}
